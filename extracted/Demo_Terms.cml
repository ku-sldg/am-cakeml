(** val gen_asp :
    coq_ASP_ID -> coq_ASP_ARGS -> coq_Plc -> coq_TARG_ID -> coq_Term **)

fun gen_asp asp_id args targPlc targId =
  Coq_asp (ASPC (Coq_asp_paramsC asp_id args targPlc targId))

(** val gather_file_contents : coq_ASP_ID **)

val gather_file_contents : coq_ASP_ID =
  "readfile"

(** val hash_file_contents : coq_ASP_ID **)

val hash_file_contents : coq_ASP_ID =
  "hashfile"

(** val hash_dir_contents : coq_ASP_ID **)

val hash_dir_contents : coq_ASP_ID =
  "hashdir"

(** val hash_evidence : coq_ASP_ID **)

val hash_evidence : coq_ASP_ID =
  "hashevidence"

(** val provision : coq_ASP_ID **)

val provision : coq_ASP_ID =
  "provision"

(** val gather_targ_asp :
    coq_Plc -> coq_TARG_ID -> coq_ASP_ARGS -> coq_Term **)

fun gather_targ_asp targPlc targId args =
  gen_asp gather_file_contents args targPlc targId

(** val hash_targ_asp : coq_Plc -> coq_TARG_ID -> coq_ASP_ARGS -> coq_Term **)

fun hash_targ_asp targPlc targId args =
  gen_asp hash_file_contents args targPlc targId

(** val hash_dir_asp : coq_Plc -> coq_TARG_ID -> coq_ASP_ARGS -> coq_Term **)

fun hash_dir_asp targPlc targId args =
  gen_asp hash_dir_contents args targPlc targId

(** val provision_targ_asp :
    coq_Plc -> coq_TARG_ID -> coq_ASP_ARGS -> coq_Term **)

fun provision_targ_asp targPlc targId args =
  gen_asp provision args targPlc targId

(** val hash_evidence_asp :
    coq_Plc -> coq_TARG_ID -> coq_ASP_ARGS -> coq_Term **)

fun hash_evidence_asp targPlc targId args =
  gen_asp hash_evidence args targPlc targId

(** val string_to_json : string -> coq_JSON **)

fun string_to_json s =
  JSON_String s
