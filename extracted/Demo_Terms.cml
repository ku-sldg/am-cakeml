(** val gather_file_contents : coq_ASP_ID **)

val gather_file_contents : coq_ASP_ID =
  "readfile"

(** val hash_file_contents : coq_ASP_ID **)

val hash_file_contents : coq_ASP_ID =
  "hashfile"

(** val hash_dir_contents : coq_ASP_ID **)

val hash_dir_contents : coq_ASP_ID =
  "hashdir"

(** val hash_evidence : coq_ASP_ID **)

val hash_evidence : coq_ASP_ID =
  "hashevidence"

(** val provision : coq_ASP_ID **)

val provision : coq_ASP_ID =
  "provision"

(** val gather_targ_asp :
    coq_Plc -> coq_TARG_ID -> string -> string -> string -> string -> coq_Term **)

fun gather_targ_asp targPlc targId env_var env_var_golden path path_golden =
  Coq_asp (ASPC (Coq_asp_paramsC gather_file_contents (JSON_Object
    (("env_var", (JSON_String env_var)) :: (("filepath", (JSON_String
    path)) :: (("env_var_golden", (JSON_String
    env_var_golden)) :: (("filepath_golden", (JSON_String
    path_golden)) :: []))))) targPlc targId))

(** val hash_targ_asp :
    coq_Plc -> coq_TARG_ID -> string -> string -> string -> string -> coq_Term **)

fun hash_targ_asp targPlc targId env_var env_var_golden path path_golden =
  Coq_asp (ASPC (Coq_asp_paramsC hash_file_contents (JSON_Object (("env_var",
    (JSON_String env_var)) :: (("filepath", (JSON_String
    path)) :: (("env_var_golden", (JSON_String
    env_var_golden)) :: (("filepath_golden", (JSON_String
    path_golden)) :: []))))) targPlc targId))

(** val string_to_json : string -> coq_JSON **)

fun string_to_json s =
  JSON_String s

(** val hash_dir_asp :
    coq_Plc -> coq_TARG_ID -> string -> string -> string list -> string ->
    coq_Term **)

fun hash_dir_asp targPlc targId env_var env_var_golden paths appr_path =
  Coq_asp (ASPC (Coq_asp_paramsC hash_dir_contents (JSON_Object (("env_var",
    (JSON_String env_var)) :: (("env_var_golden", (JSON_String
    env_var_golden)) :: (("paths", (JSON_Array
    (map string_to_json paths))) :: (("filepath_golden", (JSON_String
    appr_path)) :: []))))) targPlc targId))

(** val provision_targ_asp :
    coq_Plc -> coq_TARG_ID -> string -> string -> coq_Term **)

fun provision_targ_asp targPlc targId env_var path =
  Coq_asp (ASPC (Coq_asp_paramsC provision (JSON_Object (("env_var",
    (JSON_String env_var)) :: (("filepath", (JSON_String path)) :: [])))
    targPlc targId))

(** val hash_evidence_asp :
    coq_Plc -> coq_TARG_ID -> string -> string -> coq_Term **)

fun hash_evidence_asp targPlc targId env_var_golden path_golden =
  Coq_asp (ASPC (Coq_asp_paramsC hash_evidence (JSON_Object
    (("env_var_golden", (JSON_String env_var_golden)) :: (("filepath_golden",
    (JSON_String path_golden)) :: []))) targPlc targId))
