val query_kim_asp_static : coq_Term =
  query_kim_asp query_kim_args_static

(** val cds_ssl : coq_Term **)

val cds_ssl : coq_Term =
  Coq_lseq (Coq_bseq (ALL, ALL) query_kim_asp_static meas_cds) (Coq_lseq
    r_ssl_sig_asp appr_term)

(** val cds_ssl_badkey : coq_Term **)

val cds_ssl_badkey : coq_Term =
  Coq_lseq (Coq_bseq (ALL, ALL) query_kim_asp_static meas_cds) (Coq_lseq
    r_ssl_sig_asp (Coq_lseq r_tpm_sig_asp appr_term))

