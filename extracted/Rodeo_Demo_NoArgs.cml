(** val appr_term : coq_Term **)

val appr_term : coq_Term =
  Coq_asp APPR

(** val meas_theorem : coq_Term **)

val meas_theorem : coq_Term =
  Coq_bseq (ALL, ALL) hash_coq_env_dir (Coq_bseq (ALL, ALL)
    run_command_asp_coq run_command_asp_coq_test)

(** val meas_theorem_appr : coq_Term **)

val meas_theorem_appr : coq_Term =
  Coq_lseq meas_theorem appr_term

(** val meas_micro : coq_Term **)

val meas_micro : coq_Term =
  Coq_lseq (Coq_bseq (ALL, ALL) hash_micro_dir_1 hash_micro_dir_2)
    hash_micro_evidence

(** val micro_appTerm : coq_Term **)

val micro_appTerm : coq_Term =
  Coq_lseq meas_micro appr_term

(** val coq_coq_appTerm_provision : coq_Term **)

val coq_coq_appTerm_provision : coq_Term =
  Coq_bseq (ALL, ALL) (Coq_lseq hash_coq_env_dir provision_coq_env_dir)
    (Coq_bseq (ALL, ALL) (Coq_lseq run_command_asp_coq provision_asp_coq)
    (Coq_lseq run_command_asp_coq_test provision_asp_coq_test))

(** val micro_appTerm_provision : coq_Term **)

val micro_appTerm_provision : coq_Term =
  Coq_bseq (ALL, ALL) (Coq_lseq hash_micro_dir_1 provision_micro_dir_1)
    (Coq_bseq (ALL, ALL) (Coq_lseq hash_micro_dir_2 provision_micro_dir_2)
    (Coq_lseq meas_micro provision_micro_hash_composite))

(** val coq_coq_env_provision_dir : coq_Term **)

val coq_coq_env_provision_dir : coq_Term =
  Coq_lseq hash_coq_env_dir provision_coq_env_dir

(** val micro_appTerm_provision_dir_1 : coq_Term **)

val micro_appTerm_provision_dir_1 : coq_Term =
  Coq_lseq hash_micro_dir_1 provision_micro_dir_1

(** val micro_appTerm_provision_dir_2 : coq_Term **)

val micro_appTerm_provision_dir_2 : coq_Term =
  Coq_lseq hash_micro_dir_2 provision_micro_dir_2

(** val micro_appTerm_provision_composite : coq_Term **)

val micro_appTerm_provision_composite : coq_Term =
  Coq_lseq meas_micro provision_micro_hash_composite

(** val resolute_terms_noargs_map : (string * coq_Term) list **)

val resolute_terms_noargs_map : (string * coq_Term) list =
  ("micro_noargs", micro_appTerm) :: (("micro_provision_noargs",
    micro_appTerm_provision) :: (("micro_provision_dir_1_noargs",
    micro_appTerm_provision_dir_1) :: (("micro_provision_dir_2_noargs",
    micro_appTerm_provision_dir_2) :: (("micro_provision_composite_noargs",
    micro_appTerm_provision_composite) :: (("run_coq_thm_noargs",
    run_command_asp_coq) :: (("run_coq_test_noargs",
    run_command_asp_coq_test) :: (("run_coq_all_noargs",
    meas_theorem) :: (("run_coq_all_appr_noargs",
    meas_theorem_appr) :: (("coq_env_dir_provision_noargs",
    coq_coq_env_provision_dir) :: (("coq_provision_all_noargs",
    coq_coq_appTerm_provision) :: []))))))))))
